# OPS-032 staging OSS/CDN environment template.
# Copy to .deploy.env or merge into the staging env file. Do not commit real secrets.

APP_ENV=staging
NODE_ENV=production

# Public entrypoints for staging.
# Use the final staging domain when CDN/HTTPS is ready.
PUBLIC_BASE_URL=https://staging.example.com
PUBLIC_UPLOAD_BASE_URL=https://staging.example.com/uploads
FRONTEND_URL=https://staging.example.com
API_BASE_URL=https://staging.example.com/api
CORS_ORIGINS=https://staging.example.com

# Storage switches.
# Keep production on local until staging smoke is verified.
MEDIA_STORAGE_PROVIDER=oss
OSS_DIRECT_UPLOAD_ENABLED=true
VITE_OSS_DIRECT_UPLOAD_ENABLED=true
VOICE_SAMPLE_STORAGE=oss
RENDER_OUTPUT_STORAGE=oss

# OSS credentials.
# Use a dedicated RAM user with the policy in deploy/oss-staging-ram-policy.example.json.
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
ALI_OSS_BUCKET=shuziren-staging
ALI_OSS_REGION=oss-cn-beijing

# Browser direct PUT signed URLs must use a public OSS endpoint or upload CNAME.
# Do not use oss-cn-*-internal.aliyuncs.com when VITE_OSS_DIRECT_UPLOAD_ENABLED=true.
ALI_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com

# Isolate staging objects from production.
ALI_OSS_UPLOAD_PREFIX=staging/runtime-assets
VOICE_SAMPLE_OSS_PREFIX=staging/voice-samples
RENDER_OUTPUT_OSS_PREFIX=staging/render-output
OSS_SIGNED_UPLOAD_TTL_SECONDS=900
RENDER_OUTPUT_OSS_SIGNED_URL_TTL_SECONDS=604800

# Optional CDN smoke checks.
# Set after CDN domain is configured. Range must return 206 for video playback.
SMOKE_OSS_CDN_URL=
SMOKE_OSS_CDN_REQUIRE_HTTPS=1

# Optional public template sample image smoke check.
# Use one representative public subtitle/avatar template sample image URL.
# URL must be controlled static/OSS/CDN, return image/*, public max-age cache,
# and must not contain signed query credentials.
SMOKE_PUBLIC_TEMPLATE_IMAGE_URL=/template-previews/ops-036-template-sample.svg
SMOKE_PUBLIC_TEMPLATE_REQUIRED=1
SMOKE_PUBLIC_TEMPLATE_REQUIRE_HTTPS=1

# Optional live OSS write/read/delete verification.
# Keep disabled unless using staging-only credentials and bucket.
OPS_032_LIVE_CHECK=0
OPS_032_ALLOW_PROD_BUCKET=0
