# 复制为 deploy/compose.env（勿提交密钥），启动：
#   docker compose --env-file deploy/compose.env up -d --build

# ----- 抖音源视频 / dy-downloader（首页「获取视频信息」等；不上线抖音可留空）-----
DY_DOWNLOADER_COOKIE=
# DY_DOWNLOADER_FETCH_TIMEOUT_MS=120000

# ----- 服务端保存 MP4 目录（容器内路径；默认与 docker-compose 卷一致）-----
# VIDEO_SAVE_DIR=/workspace/data/download-video

# ----- FFmpeg（api 镜像已带 /usr/bin/ffmpeg；一般无需改）-----
# FFMPEG_BIN=/usr/bin/ffmpeg

# ----- 口播转写 ASR（配置见 backend/.env.example；OPENAI_API_KEY / ASR_*）-----

# ----- 入口 -----
# WEB_PORT=8080
# WEB_BIND_HOST=127.0.0.1
# PUBLIC_BASE_URL=https://your-domain.example
# PUBLIC_UPLOAD_BASE_URL=https://your-domain.example/uploads
# VOICE_PROVIDER_STREAM_SECRET=replace-with-random-secret
# UPLOAD_DIR=/workspace/uploads
# VOICE_SAMPLE_STORAGE=local
# VOICE_SAMPLE_OSS_PREFIX=voice-samples
# ALI_OSS_ACCESS_KEY_ID=
# ALI_OSS_ACCESS_KEY_SECRET=
# ALI_OSS_BUCKET=
# ALI_OSS_REGION=oss-cn-hangzhou
# ALI_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# ----- 可选 OpenAI（改写等）-----
# OPENAI_API_KEY=

# ----- 视频对口型（阿里接口；后端会代理 multipart 上传）-----
# ALI_LIP_SYNC_API_URL=
# ALI_LIP_SYNC_API_KEY=
# ALI_LIP_SYNC_VIDEO_FIELD=video
# ALI_LIP_SYNC_DURATION_FIELD=duration_seconds

# ----- 前后端分离 / 公网 CORS（Web 与 API 不同源时填写；留空则任意 Origin，与开发一致）-----
# CORS_ORIGINS=https://your-domain.example
# USER_UPLOAD_RESOURCE_TTL_DAYS=7
# USER_UPLOAD_RESOURCE_CLEANUP_INTERVAL_MS=3600000
