# 复制到仓库根目录并重命名为 .env，供 docker compose 读取（勿提交 git）
# cp deploy/docker.env.example .env
#
# 数字人 / OpenAI / 抖音 Cookie 等也可只写在 backend/.env（与本地 Nest 一致）；
# docker-compose 已把 backend/.env 作为第二份 env_file 注入 api 容器，无需再抄到根 .env。

# --- 对外端口：默认 8080，改 80 需本机有权限 ---
WEB_PORT=8080
# 生产环境走宿主机 Nginx HTTPS 反代时，Docker web 只绑定本机，避免公网绕过 HTTPS 访问 8080。
WEB_BIND_HOST=127.0.0.1

# 浏览器实际访问媒体资源时使用的公网 / 局域网地址。
# 本机 Docker 调试可保持 localhost；线上请改为域名或服务器 IP。
PUBLIC_BASE_URL=https://your-domain.example
PUBLIC_UPLOAD_BASE_URL=https://your-domain.example/uploads
CORS_ORIGINS=https://your-domain.example
VOICE_PROVIDER_STREAM_SECRET=请改为随机长字符串

# API 容器内上传目录，需与 docker-compose 的 volume 挂载保持一致。
UPLOAD_DIR=/workspace/uploads
TEMP_DIR=/workspace/tmp
VIDEO_SAVE_DIR=/workspace/data/download-video
PREVIEW_VIDEO_SAVE_DIR=/workspace/data/preview-videos
PREVIEW_AUDIO_SAVE_DIR=/workspace/data/preview-audios
LIP_SYNC_PUBLIC_MEDIA_DIR=/workspace/data/lip-sync-public
VOICE_SAMPLE_DIR=/workspace/data/voice-samples
# 声音样本存储：local | oss（默认 local）
# VOICE_SAMPLE_STORAGE=local
# VOICE_SAMPLE_OSS_PREFIX=voice-samples
# ALI_OSS_ACCESS_KEY_ID=
# ALI_OSS_ACCESS_KEY_SECRET=
# ALI_OSS_BUCKET=
# ALI_OSS_REGION=oss-cn-hangzhou
# ALI_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
DIGITAL_HUMAN_STORAGE_DIR=/workspace/data/digital-humans
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
YTDLP_BIN=/usr/local/bin/yt-dlp
ASR_PYTHON_BIN=python3
ASR_FUNASR_SCRIPT=/workspace/scripts/dashscope_funasr_transcribe.py

# --- 与 docker-compose 内 MySQL 一致（若使用 compose 自带 mysql，保持默认即可）---
MYSQL_ROOT_PASSWORD=请改为强密码
MYSQL_DATABASE=koubo
MYSQL_USER=koubo
MYSQL_PASSWORD=请改为强密码

# 宿主机映射端口（默认 3306）。若 ECS 上已有本机 MySQL 占 3306，改为 3307 等，避免 bind: address already in use
# MYSQL_HOST_PORT=3307

# --- 生产务必设置（登录 JWT）---
JWT_SECRET=请使用 openssl rand -base64 48 生成

# bcrypt 轮数（默认 8，适合 2GB 内存；可改为 10 提高算力成本）
BCRYPT_ROUNDS=8

# --- 可选：浏览器访问的前端 Origin（逗号分隔），不配则 CORS 较宽松 ---
# CORS_ORIGINS=https://你的域名

# 用户上传素材保留期（天）与后台清理周期（毫秒）
USER_UPLOAD_RESOURCE_TTL_DAYS=7
# USER_UPLOAD_RESOURCE_CLEANUP_INTERVAL_MS=3600000

# --- 若 MySQL 装在宿主机而非 compose：---
# 1) 注释掉 docker-compose.yml 里的 mysql 服务
# 2) 删掉 api.depends_on 里 mysql 段（若 api 仅依赖外部 MySQL）
# 3) 取消下面两行注释并填写宿主机上的库名与用户
# MYSQL_HOST=host.docker.internal
# MYSQL_USER=root

# 数字人图片持久化目录（与 docker-compose 内卷挂载一致，一般无需改）
# DIGITAL_HUMAN_STORAGE_DIR=/workspace/backend/data/digital-humans

# --- 口播转写 ASR（见 backend/.env.example：DASHSCOPE_API_KEY / QWEN_ASR_MODEL）---
# 推荐写在 backend/.env，由 compose env_file 注入 api 容器

# --- 数字人「自拍照 → 形象图」：三选一，至少配一条，否则前端会提示未配置（实际保存的是原图 mock）---
# 勿写空行 ARK_API_KEY=（会覆盖 backend/.env 里的密钥）。要配时再取消注释并填值，或只写在 backend/.env。
#
# A) 火山方舟（推荐，只配密钥即可，默认已指向北京 endpoint + 图片模型）
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
#
# B) jiekou.ai 等 Seedream 兼容（整段 URL + Bearer，需两项同时配置）
# SEEDREAM_HTTP_URL=https://api.jiekou.ai/v3/seedream-4.5
# SEEDREAM_API_KEY=
#
# C) 自建 HTTP 接口（POST JSON，见 backend 代码 DigitalHumanImageService）
# DIGITAL_HUMAN_API_URL=
# DIGITAL_HUMAN_API_KEY=

# --- 视频对口型：后端代理 multipart 上传到阿里接口（字段名默认 video）---
# ALI_LIP_SYNC_API_URL=
# ALI_LIP_SYNC_API_KEY=
# 可复用 DASHSCOPE_API_KEY；默认视频字段 video、时长字段 duration_seconds
# ALI_LIP_SYNC_VIDEO_FIELD=video
# ALI_LIP_SYNC_DURATION_FIELD=duration_seconds
# ALI_LIP_SYNC_TIMEOUT_MS=900000
# ALI_LIP_SYNC_VIDEO_MAX_BYTES=314572800

# --- 抖音 / 其它大模型：参考 backend/.env.example ---
# OPENAI_API_KEY=
# DY_DOWNLOADER_COOKIE=
