# --- 公网 / 反代（可选）---
# 逗号分隔的浏览器 Origin，如 https://www.example.com,https://app.example.com
# 不设置时：与开发一致，CORS 为 origin: true（任意来源）
# CORS_ORIGINS=
# 设为 1 或 true 时：信任反向代理的 X-Forwarded-*（与 Nginx 同机部署时建议开启）
# TRUST_PROXY=

# 大模型（OpenAI 兼容 Chat Completions）：可全部只用火山方舟，无需 OPENAI_API_KEY
# 仅填下方 ARK_* 即可；未设 OPENAI_MODEL 且仅用 ARK 时默认 doubao-seed-2-0-lite-260215
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
# ARK_CHAT_MODEL=doubao-seed-2-0-lite-260215
# 说明：Python SDK 的 client.responses.create 走 Responses API；本仓库改写/口播优化走 /chat/completions，与官网「对话」一致。

# 第二步「生成视频」大模型（OpenAI 兼容 Chat Completions）；不填则回退到上面的 OPENAI_*
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=120000
# 首页预览用演示 MP4；设为 none 则不返回地址
# GENERATE_VIDEO_DEMO_MP4_URL=

# --- jiekou Seedance 1.5 Pro 图生视频（异步，POST /v3/async/seedance-v1.5-pro-i2v）---
# 联调：POST /api/v1/tools/seedance-i2v-async，body 至少含 image、prompt；其余字段见 SeedanceI2vService
# SEEDANCE_I2V_API_URL=https://api.jiekou.ai/v3/async/seedance-v1.5-pro-i2v
# SEEDANCE_I2V_API_KEY=
# 未单独配置时可回退 JIEKOU_API_KEY、SEEDREAM_API_KEY
# JIEKOU_API_KEY=
# SEEDANCE_I2V_HTTP_TIMEOUT_MS=120000
# 以下为请求体默认值（可被 body 覆盖）：fps、ratio、duration、resolution、watermark、camera_fixed、generate_audio、execution_expires_after
# SEEDANCE_I2V_FPS=24
# SEEDANCE_I2V_RATIO=9:16
# SEEDANCE_I2V_DURATION=5
# SEEDANCE_I2V_RESOLUTION=1080p
# SEEDANCE_I2V_WATERMARK=1
# SEEDANCE_I2V_CAMERA_FIXED=1
# SEEDANCE_I2V_GENERATE_AUDIO=1
# SEEDANCE_I2V_EXECUTION_EXPIRES_AFTER=86400
# SEEDANCE_I2V_SEED=
# SEEDANCE_I2V_LAST_IMAGE=
# SEEDANCE_I2V_SERVICE_TIER=

# --- 数字人自拍照→形象图（多选一，优先级自上而下）---
#
# A) jiekou.ai 等「整段 URL」Seedream（如 /v3/seedream-4.5）：与方舟不同，body 无 model/response_format
# SEEDREAM_HTTP_URL=https://api.jiekou.ai/v3/seedream-4.5
# SEEDREAM_API_KEY=
# SEEDREAM_IMAGE_SIZE=2K
# SEEDREAM_IMAGE_WATERMARK=1
# SEEDREAM_HTTP_TIMEOUT_MS=300000
# 组图：与方舟一致可回退 ARK_SEQUENTIAL_*；或单独设 SEEDREAM_SEQUENTIAL_IMAGE_GENERATION / SEEDREAM_SEQUENTIAL_MAX_IMAGES
# SEEDREAM_SEQUENTIAL_IMAGE_GENERATION=auto
# SEEDREAM_SEQUENTIAL_MAX_IMAGES=3
# 仅在有值时发送：optimize_prompt_options.mode（值以控制台文档为准）
# SEEDREAM_OPTIMIZE_PROMPT_MODE=
# 参考图：默认 image 为 data URL 字符串数组；若接口要求对象数组则 SEEDREAM_IMAGE_ITEM_STYLE=object，键名默认 image，可改 SEEDREAM_IMAGE_OBJECT_KEY
# SEEDREAM_IMAGE_ITEM_STYLE=string
# SEEDREAM_IMAGE_OBJECT_KEY=image
#
# B) 火山方舟图片生成：ARK_API_KEY；POST {ARK_BASE_URL}/images/generations
#    会携带用户自拍参考图 image: [data:image/...;base64,...]，sequential_image_generation 默认 auto（设 disabled 可关组图）
#    与官方 Python：OpenAI(api_key=..., base_url="https://ark.cn-beijing.volces.com/api/v3") 使用同一网关前缀（仅路径不同）。
# ARK_API_KEY=
# 默认 https://ark.cn-beijing.volces.com/api/v3（与路径 /images/generations 拼接；若曾写 …/v3/v1 仍兼容）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
# ARK_IMAGE_SIZE=2K
# ARK_IMAGE_WATERMARK=1
# ARK_IMAGE_TIMEOUT_MS=300000
# 组图：auto | disabled（默认 auto）
# ARK_SEQUENTIAL_IMAGE_GENERATION=auto
# sequential_image_generation_options.max_images，范围 1～15（默认 3）
# ARK_SEQUENTIAL_MAX_IMAGES=3
# 追加在风格预设后的中文说明（可选，不填则用内置）
# ARK_IMAGE_PROMPT_SUFFIX=
#
# 火山方舟「图生视频」异步任务：POST /api/v3/contents/generations/tasks（联调：POST /api/v1/tools/ark-i2v-task）
# 可与上图共用 ARK_API_KEY；也可单独设 ARK_I2V_API_KEY
# ARK_I2V_MODEL=doubao-seedance-1-5-pro-251215
# ARK_I2V_HTTP_TIMEOUT_MS=120000
# 首页「预览成片」轮询方舟任务：总时长与间隔（毫秒）
# ARK_I2V_POLL_MAX_MS=600000
# ARK_I2V_POLL_INTERVAL_MS=2500
#
# C) 自定义网关：POST JSON（ content + image_base64 + mime_type + style_id ）
# DIGITAL_HUMAN_API_URL=
# DIGITAL_HUMAN_API_KEY=
# DIGITAL_HUMAN_API_TIMEOUT_MS=120000
# 落盘目录（默认 backend/data/digital-humans）；元数据见下方 MySQL / SQLite
# DIGITAL_HUMAN_STORAGE_DIR=

# --- 持久化（二选一）---
# 设置 MYSQL_DATABASE 后使用 MySQL（docker-compose 已包含 mysql 服务）；不设置则回退 SQLite 单文件。
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=koubo
# MYSQL_PASSWORD=
# MYSQL_DATABASE=koubo
# 未使用 MySQL 时：SQLite 路径（默认 backend/data/app.db）
# SQLITE_PATH=

# 登录 JWT 签名密钥（POST /api/v1/auth/register、/login）；生产环境务必设置强随机值
# JWT_SECRET=
# 注册/登录 bcrypt 轮数（默认 10；Docker 小内存建议 8，避免 API 被 OOM 杀死出现 Nginx 502）
# BCRYPT_ROUNDS=10
# 基础进程内限流；多实例生产环境建议同时配置 Nginx / Redis 网关限流
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AI_MAX=60
# RATE_LIMIT_GENERAL_MAX=600
#
# --- 账号审核与后台（前端 /admin；API /api/v1/admin）---
# 新注册默认 active=直接开通；如需审核制可改为 pending
# REGISTRATION_DEFAULT_ACCOUNT_STATUS=active
# 开发期后台开放给已登录账号；生产建议设为 false 并用 ADMIN_EMAILS / 用户审核授予管理员
# ADMIN_OPEN_ACCESS=true
# 逗号分隔邮箱；对已存在于 users 表的帐号生效，每次启动：设为 admin 并开通
# （若希望不经 .env、不改进程：可直接在数据库 UPDATE，见 deploy/manual-promote-admin.sql.example）
# ADMIN_EMAILS=
# 从远端 URL 拉取生成图的最大字节数（默认约 15MB）
# DIGITAL_HUMAN_IMAGE_MAX_BYTES=15728640

# --- 口播转写：唯一使用千问3-ASR-Flash-Filetrans（百炼异步长音频转写）---
# 与 Python 示例一致：OpenAI(api_key=DASHSCOPE_API_KEY, base_url="https://dashscope.aliyuncs.com/compatible-mode/v1")
# 北京地域：
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 新加坡地域：
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_ASR_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# DASHSCOPE_API_KEY=
# 阿里云千问声音克隆 / 语音合成
# 默认北京地域，如使用新加坡请改为 https://dashscope-intl.aliyuncs.com/api/v1
# DASHSCOPE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# QWEN_VOICE_TARGET_MODEL=cosyvoice-v3.5-plus
# QWEN_VOICE_DESIGN_TARGET_MODEL=cosyvoice-v3.5-plus
# 本地上传样本若未配置 PUBLIC_BASE_URL，会自动回退旧复刻模型，避免本地联调中断。
# QWEN_UPLOAD_CLONE_FALLBACK_MODEL=qwen3-tts-vc-2026-01-22
# QWEN_TTS_RESPONSE_FORMAT=mp3
# QWEN_TTS_SAMPLE_RATE=24000

# Aliyun VideoRetalk lip-sync. The provider must fetch media by public HTTP URL.
# By default the backend uploads local media to DashScope temporary OSS and passes oss:// URLs.
# For production/high concurrency, prefer your own OSS/CDN and set ALI_VIDEORETALK_USE_TEMP_UPLOAD=false.
# LIP_SYNC_PROVIDER=aliyun-videoretalk
# ALI_VIDEORETALK_USE_TEMP_UPLOAD=true
# ALI_VIDEORETALK_UPLOADS_URL=https://dashscope.aliyuncs.com/api/v1/uploads
# PUBLIC_BASE_URL=
# VOICE_PROVIDER_STREAM_SECRET=
# ALI_VIDEORETALK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# ALI_VIDEORETALK_MODEL=videoretalk
# ALI_VIDEORETALK_VIDEO_EXTENSION=false
# ALI_VIDEORETALK_POLL_MAX_MS=900000
# ALI_VIDEORETALK_POLL_INTERVAL_MS=3000
# LIP_SYNC_PUBLIC_MEDIA_DIR=

# VOICE_SAMPLE_FETCH_TIMEOUT_MS=120000
# QWEN_ASR_MODEL=qwen3-asr-flash-filetrans
# QWEN_ASR_ENABLE_ITN=false
# QWEN_ASR_ENABLE_WORDS=false
# QWEN_ASR_POLL_INTERVAL_MS=2000
# 可选：zh / en / ja / ko 等，不填则自动识别
# QWEN_ASR_LANGUAGE=
ASR_TIMEOUT_MS=600000
# 上传体积上限（字节），不填则约 200MB；兼容旧键名 WHISPER_MEDIA_MAX_BYTES
# TRANSCRIBE_MEDIA_MAX_BYTES=

# 数字人 HTTP 占位（有值时 AvatarAiService 会带上 endpoint 字段）
AVATAR_HTTP_ENDPOINT=

# 视频页抓取（非 AI）：自定义 UA / 超时（毫秒）
# VIDEO_FETCH_USER_AGENT=Mozilla/5.0 ...
# VIDEO_FETCH_TIMEOUT_MS=18000
# 从链接解析媒体后下载体积上限（字节），与转写上传上限对齐（默认约 200MB）
# VIDEO_MEDIA_MAX_BYTES=209715200

# 视频 → 抽音轨再送 ASR API（backend/ffmpeg/bin）；不填则依次尝试此处、PATH
# 本机 gyan 静态库解压后请将 ffmpeg.exe 放到 backend/ffmpeg/bin/ffmpeg.exe
# Docker 镜像内置：FFMPEG_BIN=/usr/bin/ffmpeg
# FFMPEG_BIN=/absolute/path/to/ffmpeg
# FunASR 实时转写脚本的 Python 启动方式；不要写本机用户目录，服务器上按环境覆盖即可。
# Windows 示例：ASR_PYTHON_BIN=py 且 ASR_PYTHON_ARGS=-3
# Linux 示例：ASR_PYTHON_BIN=python3
# ASR_PYTHON_BIN=python3
# ASR_PYTHON_ARGS=

# 链接转写推荐：yt-dlp（https://github.com/yt-dlp/yt-dlp ）
# 方式 A：安装官方发行版后填写可执行文件绝对路径（例如 YTDLP_BIN=/absolute/path/to/yt-dlp）
YTDLP_BIN=
# 方式 B：仓库内已有 yt-dlp-master 时可不填 YTDLP_BIN；后端会向上探测目录并用 python -m yt_dlp（需 pip install -e ./yt-dlp-master 等）
# YT_DLP_SOURCE_DIR=../yt-dlp-master
# PYTHON_BIN=python
# Windows 仅有 py 启动器：PYTHON_BIN=py 且 YTDLP_PYTHON_ARGS=-3
# YTDLP_PYTHON_ARGS=-3
YTDLP_TIMEOUT_MS=300000
# 从本机已登录浏览器读 Cookie，提高抖音等成功率（chrome / edge / firefox …）
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_PROXY=http://127.0.0.1:7890

# 源视频「保存到本机」目录（首页「获取视频信息」抖音分支会写入此目录；不存在则自动创建）
# 默认保存到项目内 backend/data/download-video，部署时建议保持项目内路径或显式挂载此目录。
# VIDEO_SAVE_DIR=./data/download-video
# PREVIEW_VIDEO_SAVE_DIR=./data/preview-videos
# PREVIEW_AUDIO_SAVE_DIR=./data/preview-audios
# LIP_SYNC_PUBLIC_MEDIA_DIR=./data/lip-sync-public
# VOICE_SAMPLE_DIR=./data/voice-samples
# 用户自上传的视频素材/声音素材保留天数；默认 7 天，到期自动删除资源记录和本地托管文件。
# USER_UPLOAD_RESOURCE_TTL_DAYS=7
# USER_UPLOAD_RESOURCE_CLEANUP_INTERVAL_MS=3600000

# --- 抖音下载（必选）：仓库内 backend/DY-DOWNLOADER（npm 名 dy-downloader），仅走 Cookie，不走 yt-dlp ---
# 将浏览器复制的整段 Cookie 写入本机 backend/.env（勿把真实值提交 git）
# DY_DOWNLOADER_COOKIE=
# DY_DOWNLOADER_FETCH_TIMEOUT_MS=120000
