# Copy to .env on the target machine. Never commit real secrets.

# Runtime
NODE_ENV=production
WEB_PORT=8080
# Production behind host Nginx should bind Docker web to loopback only.
WEB_BIND_HOST=127.0.0.1
APP_VERSION=local
GIT_COMMIT=unknown
BUILD_TIME_UTC=unknown

# Public URLs used by browser and third-party providers.
PUBLIC_BASE_URL=https://your-domain.example
PUBLIC_UPLOAD_BASE_URL=https://your-domain.example/uploads
CORS_ORIGINS=https://your-domain.example
TRUST_PROXY=1

# Auth
JWT_SECRET=replace-with-openssl-rand-base64-48
BCRYPT_ROUNDS=8
ID_CARD_HASH_SECRET=replace-with-openssl-rand-base64-48
# New normal users stay pending until an admin activates them.
REGISTRATION_DEFAULT_ACCOUNT_STATUS=pending
AUTH_RESET_WINDOW_MS=900000
AUTH_RESET_MAX_ATTEMPTS_PER_IP=20
AUTH_RESET_MAX_ATTEMPTS_PER_ACCOUNT=6
AUTH_RESET_MAX_FAILURES_PER_IP=10
AUTH_RESET_MAX_FAILURES_PER_ACCOUNT=5

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=koubo
MYSQL_USER=koubo
MYSQL_PASSWORD=replace-with-strong-user-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306

# Storage directories inside the API container.
UPLOAD_DIR=/workspace/uploads
TEMP_DIR=/workspace/tmp
VIDEO_SAVE_DIR=/workspace/data/download-video
PREVIEW_VIDEO_SAVE_DIR=/workspace/data/preview-videos
PREVIEW_AUDIO_SAVE_DIR=/workspace/data/preview-audios
LIP_SYNC_PUBLIC_MEDIA_DIR=/workspace/data/lip-sync-public
VOICE_SAMPLE_DIR=/workspace/data/voice-samples
DIGITAL_HUMAN_STORAGE_DIR=/workspace/data/digital-humans
USER_UPLOAD_RESOURCE_TTL_DAYS=7
USER_UPLOAD_RESOURCE_CLEANUP_INTERVAL_MS=3600000
# Voice sample storage backend: local | oss
VOICE_SAMPLE_STORAGE=local
VOICE_SAMPLE_OSS_PREFIX=voice-samples
RENDER_OUTPUT_STORAGE=local
RENDER_OUTPUT_OSS_PREFIX=runtime-assets/result
RENDER_OUTPUT_OSS_PUBLIC_BASE_URL=
RENDER_OUTPUT_OSS_SIGNED_URL_TTL_SECONDS=604800
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
ALI_OSS_BUCKET=
# Either set ALI_OSS_REGION or ALI_OSS_ENDPOINT
ALI_OSS_REGION=
ALI_OSS_ENDPOINT=

# Runtime binaries inside the API container.
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
YTDLP_BIN=/usr/local/bin/yt-dlp
YTDLP_TIMEOUT_MS=300000
ASR_PYTHON_BIN=python3
ASR_FUNASR_SCRIPT=/workspace/scripts/dashscope_funasr_transcribe.py

# Aliyun DashScope / ASR / TTS / VideoReTalk.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_API_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_ASR_MODEL=fun-asr-realtime
QWEN_ASR_LANGUAGE=zh
QWEN_ASR_SAMPLE_RATE=16000
ASR_TIMEOUT_MS=600000
QWEN_VOICE_TARGET_MODEL=cosyvoice-v2
QWEN_VOICE_DESIGN_TARGET_MODEL=cosyvoice-v3.5-plus
QWEN_TTS_RESPONSE_FORMAT=mp3
QWEN_TTS_SAMPLE_RATE=24000

# Lip sync provider.
LIP_SYNC_PROVIDER=aliyun-videoretalk
ALI_VIDEORETALK_USE_TEMP_UPLOAD=true
ALI_VIDEORETALK_UPLOADS_URL=https://dashscope.aliyuncs.com/api/v1/uploads
ALI_VIDEORETALK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VIDEO_RETALK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/image2video/video-synthesis/
ALI_VIDEORETALK_MODEL=videoretalk
ALI_VIDEORETALK_VIDEO_EXTENSION=false
# Local/staging can use 30-45 minutes for long provider queues after media preflight is enabled.
# Production changes must be confirmed because this may keep tasks and provider polling alive longer.
ALI_VIDEORETALK_POLL_MAX_MS=1800000
ALI_VIDEORETALK_POLL_INTERVAL_MS=3000
ALI_VIDEORETALK_RECOVER_WINDOW_MS=86400000
ALI_VIDEORETALK_INPUT_MAX_BYTES=314572800
ALI_VIDEORETALK_MEDIA_MAX_SOURCE_DURATION_SECONDS=120
ALI_VIDEORETALK_MEDIA_MAX_SOURCE_SIZE_BYTES=314572800
ALI_VIDEORETALK_MEDIA_MAX_PREPARED_DURATION_SECONDS=120
ALI_VIDEORETALK_MEDIA_MAX_PREPARED_SIZE_BYTES=314572800
ALI_VIDEORETALK_MEDIA_MAX_PREPARED_WIDTH=2048
ALI_VIDEORETALK_MEDIA_MAX_PREPARED_HEIGHT=2048
ALI_VIDEORETALK_MEDIA_ALLOWED_PIX_FMTS=
ALI_VIDEORETALK_MEDIA_MAX_AUDIO_DURATION_SECONDS=120
ALI_VIDEORETALK_MEDIA_MAX_AUDIO_SIZE_BYTES=31457280
VOICE_PROVIDER_STREAM_SECRET=replace-with-random-long-secret

# Douyin downloader.
DY_DOWNLOADER_COOKIE=
DY_DOWNLOADER_FETCH_TIMEOUT_MS=300000

# Performance guards.
ENABLE_LEGACY_TOOLS_ENDPOINTS=false
ENABLE_LEGACY_TASKS_ENDPOINTS=false
AI_API_MAX_CONCURRENCY=4
AI_API_QUEUE_LIMIT=100
AI_API_MAX_RETRIES=0
AI_API_RETRY_DELAY_MS=500
FFMPEG_MAX_CONCURRENCY=2
FFMPEG_QUEUE_LIMIT=20
FFMPEG_TIMEOUT_MS=1200000
RENDER_QUEUE_CONCURRENCY=1
RENDER_QUEUE_LIMIT=50
VIDEO_TASK_PER_USER_CONCURRENCY=2
LIPSYNC_COMPLETED_DEDUPE_WINDOW_MS=1800000
TTS_TASK_PER_USER_CONCURRENCY=1
TTS_TASK_QUEUE_CONCURRENCY=2
TTS_TASK_QUEUE_LIMIT=50
TASK_CACHE_MAX=1000
TASK_CACHE_TTL_MS=21600000
TRANSCRIPT_STORE_MAX=200
TRANSCRIPT_STORE_TTL_MS=21600000
